# 生产构建环境变量（Vite 在 build 时注入到前端产物）
# 注意：VITE_ 变量会出现在前端代码中，仅可放“公开”信息（如 OAuth Client ID），切勿放密钥。

# Google OAuth Web Client ID（与后端 GOOGLE_CLIENT_ID 一致）
# 当前服务器（中国大陆）无法访问 Google 验签接口，登录会卡死，故暂时停用 Google 登录。
# 取消下一行注释并重新构建即可重新启用（需服务器能出网访问 Google）。
# VITE_GOOGLE_CLIENT_ID=你的_Google_OAuth_Client_ID

# 站点根 URL（canonical / og:url 用）；与实际访问域名一致
VITE_PUBLIC_APP_ORIGIN=https://tarot.zaopic.cn

# 前后端分域部署时填写 API 的公开 Origin（不带 /api）；同域 Nginx 反代则留空。
# VITE_PUBLIC_API_ORIGIN=https://api.example.com

# Public OSS image origin, no trailing slash.
VITE_PUBLIC_OSS_ORIGIN=https://tarot-1.oss-cn-hangzhou.aliyuncs.com

# Uploaded images origin. Keep object keys identical to /uploads/...
# If an OSS upload is missing, the app falls back to same-origin /uploads.
VITE_PUBLIC_UPLOADS_ORIGIN=https://tarot-1.oss-cn-hangzhou.aliyuncs.com
