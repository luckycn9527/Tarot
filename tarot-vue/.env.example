# 前端环境变量示例
# 复制本文件为 .env 后填入真实值

# Google OAuth Client ID（可选）
VITE_GOOGLE_CLIENT_ID=

# Public OSS image origin, no trailing slash.
VITE_PUBLIC_OSS_ORIGIN=https://tarot-1.oss-cn-hangzhou.aliyuncs.com

# Optional: uploaded images origin. Keep object keys identical to /uploads/...
VITE_PUBLIC_UPLOADS_ORIGIN=https://tarot-1.oss-cn-hangzhou.aliyuncs.com
