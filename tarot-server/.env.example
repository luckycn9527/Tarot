# Server
PORT=5174
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# 生产环境请使用强密码
DB_PASSWORD=
DB_NAME=tarot_qa

# JWT
# 生产环境请使用 `openssl rand -hex 32` 生成至少 32 字节的随机字符串
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# DeepSeek API
# 从 https://platform.deepseek.com/api_keys 创建
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# 密码找回 / 重置邮件
APP_PUBLIC_ORIGIN=http://localhost:5173
PASSWORD_RESET_EXPIRES_HOURS=1

# SMTP 发信（未配置时开发模式后端控制台会打印重置链接）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 管理后台（生产环境务必配置独立强随机值）
ADMIN_USERNAME_PEPPER=
ADMIN_JWT_SECRET=

# Cookie 安全（HTTPS 生产环境设为 true）
COOKIE_SECURE=false

# Google OAuth（可选）
GOOGLE_CLIENT_ID=

# Public OSS image origin, no trailing slash.
PUBLIC_ASSET_ORIGIN=https://tarot-1.oss-cn-hangzhou.aliyuncs.com
PUBLIC_UPLOADS_ORIGIN=https://tarot-1.oss-cn-hangzhou.aliyuncs.com
