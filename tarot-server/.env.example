# Server
PORT=5174
NODE_ENV=development
# 0=不信任代理；单层 Nginx 反代使用 1。
TRUST_PROXY=1

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# 生产环境请使用强密码
DB_PASSWORD=
DB_NAME=tarot_qa

# JWT
# 生产环境请使用 `openssl rand -hex 32` 生成至少 32 字节的随机字符串
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# DeepSeek API（占卜解读必填；生产环境未配置将拒绝启动）
# 从 https://platform.deepseek.com/api_keys 创建；国内服务器不可直连时可填写兼容网关。
DEEPSEEK_API_KEY=
# 可带 /v1，但不要末尾 /。
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Per-user AI spend guard.
AI_RATE_LIMIT_PER_MIN=8
# 每日免费额度按此 IANA 时区重置；国内建议 Asia/Shanghai，海外建议 UTC。
QUOTA_TIME_ZONE=UTC

# Creem payments. Create one recurring monthly and one recurring yearly product in Creem.
# Keep CREEM_ENABLED=false until all IDs/secrets below have been configured.
CREEM_ENABLED=false
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_API_BASE_URL=https://api.creem.io
CREEM_MONTHLY_PRODUCT_ID=
CREEM_YEARLY_PRODUCT_ID=
CREEM_MONTHLY_PRICE_CENTS=990
CREEM_YEARLY_PRICE_CENTS=8990
CREEM_CURRENCY=USD

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# 密码找回 / 重置邮件
APP_PUBLIC_ORIGIN=http://localhost:5173
PASSWORD_RESET_EXPIRES_HOURS=1

# SMTP 发信（未配置时开发模式后端控制台会打印重置链接）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 管理后台（生产环境务必配置独立强随机值）
ADMIN_USERNAME_PEPPER=
ADMIN_JWT_SECRET=

# Cookie 安全（HTTPS 生产环境设为 true）
COOKIE_SECURE=false

# Google OAuth（可选）
GOOGLE_CLIENT_ID=

# Public OSS image origin, no trailing slash.
PUBLIC_ASSET_ORIGIN=https://tarot-1.oss-cn-hangzhou.aliyuncs.com
PUBLIC_UPLOADS_ORIGIN=https://tarot-1.oss-cn-hangzhou.aliyuncs.com

# Admin uploads -> Aliyun OSS. If these are empty, uploads stay in local /uploads.
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
OSS_PREFIX=
OSS_PUBLIC_BASE_URL=https://tarot-1.oss-cn-hangzhou.aliyuncs.com
OSS_ACL=
OSS_CACHE_CONTROL=public, max-age=31536000, immutable
